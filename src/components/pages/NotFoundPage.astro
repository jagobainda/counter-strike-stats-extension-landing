---
import type { HomeData, PageData } from "../../lib/types";
import SiteFooter from "../sections/SiteFooter.astro";
import SiteHeader from "../sections/SiteHeader.astro";
import ButtonLink from "../ui/ButtonLink.astro";
import Label from "../ui/Label.astro";
import RegMarks from "../ui/RegMarks.astro";

interface Props {
    page: PageData;
    home: HomeData;
}

const { page, home } = Astro.props;
---

<SiteHeader labels={home.labels} />
<main class="grid min-h-0 place-items-center py-(--gutter)">
    <div
        class="@container relative grid w-full max-w-3xl gap-[clamp(0.5rem,3dvh,1.5rem)] border border-(--ink) p-[clamp(0.75rem,4dvh,3rem)]"
        data-animate="rise"
    >
        <Label>{page.labels.code}</Label>
        <h1 class="font-display text-[clamp(1.75rem,min(8vw,12dvh),5rem)] leading-[0.95] tracking-[-0.02em] lowercase">
            {page.heading}
        </h1>
        <p class="max-w-prose text-[clamp(0.9375rem,2vw,1.25rem)] text-(--ink-2)">{page.description}</p>
        <ButtonLink href="/" class="justify-self-start">
            {page.labels.back}
        </ButtonLink>
        <RegMarks />
    </div>
</main>
<SiteFooter footer={home.footer} />

<script>
    import { playEntrance, pressFeedback } from "../../scripts/animations";

    playEntrance();
    pressFeedback();
</script>
