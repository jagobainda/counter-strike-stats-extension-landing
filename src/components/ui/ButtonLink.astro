---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"a"> {
    icon?: string;
    variants?: { id: string; icon: string; label: string }[];
}

const { icon, variants, class: className, ...attrs } = Astro.props;
const iconClass = "size-4 shrink-0";
---

<a
    {...attrs}
    data-press
    class:list={[
        "inline-flex min-h-10 items-center justify-center gap-2.5 bg-(--ink) px-3 font-mono text-xs font-semibold tracking-[0.1em] text-(--bg) uppercase transition-[color,background-color] duration-150 ease-out hover:bg-(--red-deep) hover:text-(--paper) @sm:min-h-12 @sm:px-5 @sm:text-[0.8125rem]",
        className,
    ]}
>
    {icon ? <Icon name={icon} aria-hidden="true" class={iconClass} /> : <span class="size-2.5 bg-(--red)" />}
    <slot />
    {variants?.map(variant => (
        <template data-variant={variant.id}>
            <Icon name={variant.icon} aria-hidden="true" class={iconClass} />
            {variant.label}
        </template>
    ))}
</a>
