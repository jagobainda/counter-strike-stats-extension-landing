---
import { Font } from "astro:assets";
import { OG_IMAGE, SITE_NAME, THEME_COLOR, absoluteUrl, jsonLdHtml } from "../lib/seo";

interface Props {
    title: string;
    description: string;
    ogImageAlt?: string;
    ogType?: string;
    noindex?: boolean;
    jsonLd?: object;
}

const { title, description, ogImageAlt = title, ogType = "website", noindex = false, jsonLd } = Astro.props;

// build.format "file" renders the home as /index.html; its canonical is the root.
const canonicalURL = absoluteUrl(Astro.url.pathname.replace(/\/index\.html$/, "/"));
const ogImageURL = absoluteUrl(OG_IMAGE.path);
---

<!doctype html>
<html lang="en" data-motion="done">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="theme-color" content={THEME_COLOR} />
        <title>{title}</title>
        <meta name="description" content={description} />

        {noindex ? (
            <meta name="robots" content="noindex" />
        ) : (
            <>
                <meta name="robots" content="index, follow, max-image-preview:large" />
                <link rel="canonical" href={canonicalURL} />
            </>
        )}

        <link rel="icon" type="image/png" sizes="16x16" href="/imgs/favicon/favicon-16.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/imgs/favicon/favicon-32.png" />
        <link rel="apple-touch-icon" href="/imgs/favicon/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.webmanifest" />

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {!noindex && <meta property="og:url" content={canonicalURL} />}
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:alt" content={ogImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        <Font cssVariable="--font-audiowide" preload />
        <Font cssVariable="--font-inter" preload />
        <Font cssVariable="--font-jetbrains-mono" preload />

        <!-- Entrance animations only hide content when JS is on and motion is allowed. -->
        <script is:inline>
            if (matchMedia("(prefers-reduced-motion: no-preference)").matches)
                document.documentElement.dataset.motion = "run";
        </script>

        {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLdHtml(jsonLd)} />}
    </head>

    <body class="grid h-screen grid-rows-[auto_minmax(0,1fr)_auto] bg-(--bg) p-(--gutter) font-sans text-(--ink) antialiased supports-[height:100dvh]:h-dvh">
        <slot />
    </body>
</html>

<style is:global>
    @import "../styles/global.css";
</style>
