---
import { Image } from "astro:assets";
import logo from "../../assets/logo128.png";
import Label from "../ui/Label.astro";

interface Props {
    labels: Record<string, string>;
}

const { labels } = Astro.props;
---

<header class="flex items-center justify-between gap-4 border-b border-(--ink) pb-(--gutter)">
    <Image src={logo} alt={labels.logoAlt} width={32} height={32} densities={[2]} class="size-7 lg:size-8" />
    <Label class="max-md:hidden" aria-hidden="true">
        {labels.kind} / {labels.platforms}
    </Label>
    <Label aria-hidden="true">{labels.version}</Label>
</header>
